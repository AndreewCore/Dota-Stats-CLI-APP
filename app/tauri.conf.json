{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dota-stats",
  "version": "0.1.0",
  "identifier": "com.andreew.dota-stats",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dota 2 Stats",
        "width": 1000,
        "height": 780,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
